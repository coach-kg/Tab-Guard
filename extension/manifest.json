{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.39.2",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "alarms"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "content_scripts": [
    {
      "js": [
        "src/adultSignals.js",
        "src/feedFriction.js",
        "src/shortForm.js",
        "src/bypass.js",
        "content/content.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "js": [
        "src/adultSignals.js",
        "src/shortForm.js",
        "src/bypass.js",
        "content/frame.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/overlay.js",
        "assets/i18n.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "default_locale": "en"
}
